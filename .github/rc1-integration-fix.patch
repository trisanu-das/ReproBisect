diff --git a/corpus/real-world/byteorder-rustc-build-path/reprobisect.toml b/corpus/real-world/byteorder-rustc-build-path/reprobisect.toml
--- a/corpus/real-world/byteorder-rustc-build-path/reprobisect.toml
+++ b/corpus/real-world/byteorder-rustc-build-path/reprobisect.toml
@@ -1,6 +1,6 @@
 [build]
 runner = "docker"
-image = "rust@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4"
+image = "rust@sha256:9a73a5088750b4c95158ab26629c854c3d6fc4b173cb7bc8079ad252d8ed7bfa"
 command = ["sh", "-lc", "rustc --crate-name byteorder --crate-type lib -g --emit=obj src/lib.rs -o byteorder.o"]
